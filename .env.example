# ─── Supabase (público — seguro commitar) ────────────────────────────────────
SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_URL="https://seu-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-key"
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key"

# ─── .env.local (NUNCA commitar — contém segredos) ────────────────────────────
# Copie as variáveis abaixo para um arquivo .env.local

# Supabase service role (Admin)
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Twilio — SMS OTP + notificações SMS/WhatsApp
# Crie conta em https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+55119xxxxxxxx"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Resend — e-mails transacionais
# Crie conta em https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="CondoFlow <noreply@seudominio.com>"

# URL do app em produção
APP_URL="https://seuapp.com"

# OpenAI — IA nativa (geração de tarefas, configuração de áreas, textos de
# WhatsApp, análise de eventos). Sem essa chave, a IA cai no comportamento
# padrão/regra fixa em vez de gerar conteúdo real.
# Crie a chave em https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Evolution API — WhatsApp self-hosted usado pelo motor de eventos de IA
# (avisos automáticos de reserva, tarefa, limpeza etc. pro síndico).
# Sem isso, esses avisos automáticos não são enviados (fica só registrado
# no log de atividades, sem erro visível).
EVOLUTION_API_URL="https://sua-instancia-evolution.com"
EVOLUTION_API_KEY="sua-chave-evolution"
EVOLUTION_INSTANCE="condoflow"

# Efí Bank — cobrança de taxa condominial (PIX/Boleto)
# Crie conta em https://sejaefi.com.br e uma aplicação em https://dev.efipay.com.br
EFI_CLIENT_ID="Client_Id_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EFI_CLIENT_SECRET="Client_Secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EFI_SANDBOX="true"
# Chave Pix cadastrada na conta Efí (e-mail, CPF/CNPJ, telefone ou aleatória)
EFI_PIX_KEY="sua-chave-pix"
# Segredo aleatório próprio (não vem da Efí) — vira "?hmac=..." na URL do webhook
# cadastrada no painel Efí. Gere com: openssl rand -hex 32
EFI_WEBHOOK_HMAC="gere-um-valor-aleatorio-longo"
# Pix exige certificado mTLS em toda chamada — não dá para configurar só por env var.
# Veja o passo a passo em src/lib/efi/pix.ts (cabeçalho do arquivo).

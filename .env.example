# ─── Supabase (público — seguro commitar) ────────────────────────────────────
SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_URL="https://seu-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-key"
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key"

# ─── .env.local (NUNCA commitar — contém segredos) ────────────────────────────
# Copie as variáveis abaixo para um arquivo .env.local

# Supabase service role (Admin)
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Twilio — SMS OTP + notificações SMS/WhatsApp
# Crie conta em https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+55119xxxxxxxx"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Resend — e-mails transacionais
# Crie conta em https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="CondoFlow <noreply@seudominio.com>"

# URL do app em produção
APP_URL="https://seuapp.com"
